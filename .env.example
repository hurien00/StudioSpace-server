# ---------------------------------------------------------------------------
# StudioSpace Express API environment variables
# Copy to `.env` locally and configure the same keys in your Vercel project.
# ---------------------------------------------------------------------------

# Only used when running the server directly (not on Vercel).
PORT=8000

# Public URL of this API. Used by the Better Auth instance embedded here.
BETTER_AUTH_URL=http://localhost:8000

# Must be the same secret as the Next.js app so sessions/JWTs line up.
BETTER_AUTH_SECRET=replace-with-the-same-long-random-secret

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Public URL of the deployed Next.js app. The API fetches the JWKS from
# `${CLIENT_URL}/api/auth/jwks` and only allows this origin via CORS.
# Comma-separate multiple origins, e.g.
# CLIENT_URL=https://studio-space.vercel.app,https://studio-space-git-main-you.vercel.app
CLIENT_URL=http://localhost:3000
